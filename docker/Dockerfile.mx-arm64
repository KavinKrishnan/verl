# verl + ModelExpress ARM64 Dockerfile for GB200 (GKE DGXCloud)
# Builds UCX 1.20 + NIXL from source for cross-node GPU RDMA
#
# Build:
#   docker buildx build --platform linux/arm64 \
#     -f docker/Dockerfile.mx-arm64 \
#     -t nvcr.io/nvidian/dynamo-dev/verl-mx:latest --push .

# =============================================================================
# Stage 1: Builder — compile UCX 1.20, NIXL, and install MX client
# =============================================================================
FROM nvcr.io/nvidia/cuda:12.8.1-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3-pip \
    git cmake ninja-build meson pkg-config \
    libibverbs-dev librdmacm-dev libnuma-dev \
    autoconf automake libtool curl \
    systemd-dev zlib1g-dev pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

# UCX 1.20.0 — required for cross-node GPU RDMA on GB200
RUN git clone --depth 1 -b v1.20.0 https://github.com/openucx/ucx.git /opt/ucx-src \
    && cd /opt/ucx-src \
    && ./autogen.sh \
    && ./configure --prefix=/opt/ucx-install \
        --with-cuda=/usr/local/cuda \
        --with-verbs \
        --enable-mt \
    && make -j$(nproc) \
    && make install \
    && rm -rf /opt/ucx-src

ENV PATH="/opt/ucx-install/bin:$PATH" \
    LD_LIBRARY_PATH="/opt/ucx-install/lib:$LD_LIBRARY_PATH" \
    PKG_CONFIG_PATH="/opt/ucx-install/lib/pkgconfig:$PKG_CONFIG_PATH" \
    CMAKE_PREFIX_PATH="/opt/ucx-install:$CMAKE_PREFIX_PATH"

# NIXL — NVIDIA Inference tranXfer Library
RUN git clone --depth 1 https://github.com/ai-dynamo/nixl.git /opt/nixl-src \
    && cd /opt/nixl-src \
    && mkdir -p /opt/nixl-install \
    && meson setup build \
        --prefix=/opt/nixl-install \
        -Ducx_path=/opt/ucx-install \
        -Denable_plugins=UCX \
    && cd build \
    && ninja -j2 \
    && ninja install

# NIXL Python bindings
RUN cd /opt/nixl-src \
    && python3 -m pip install --break-system-packages --no-build-isolation . || \
       (echo "pip install failed, copying binding manually" && \
        mkdir -p /usr/local/lib/python3.12/dist-packages/nixl && \
        cp -r build/src/bindings/python/* /usr/local/lib/python3.12/dist-packages/nixl/ 2>/dev/null; \
        cp build/src/bindings/python/*.so /usr/local/lib/python3.12/dist-packages/nixl/ 2>/dev/null; \
        true)

# ModelExpress Python client
RUN python3 -m pip install --break-system-packages --no-deps \
    "modelexpress @ git+https://github.com/ai-dynamo/modelexpress.git@kavink/RL#subdirectory=modelexpress_client/python" \
    && python3 -m pip install --break-system-packages grpcio protobuf

# =============================================================================
# Stage 2: Runtime — verl + vLLM + MX + NIXL
# =============================================================================
FROM nvcr.io/nvidia/cuda:12.8.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    git libibverbs1 ibverbs-providers rdma-core libnuma1 curl \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python

ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Copy UCX and NIXL from builder
COPY --from=builder /opt/ucx-install /opt/ucx-install
COPY --from=builder /opt/nixl-install /opt/nixl-install

ENV PATH="/opt/ucx-install/bin:$PATH" \
    LD_LIBRARY_PATH="/opt/ucx-install/lib:/opt/nixl-install/lib:/opt/nixl-install/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH"

# Install vLLM 0.18.1 (avoids 0.19 multiproc resource_tracker crash on ARM64)
# Let vLLM pull its own torch dependency, then reinstall CUDA version
RUN pip install vllm==0.18.1
RUN TORCH_VER=$(python3 -c "import torch; print(torch.__version__.split('+')[0])") && \
    pip install torch==${TORCH_VER} --index-url https://download.pytorch.org/whl/cu128 --force-reinstall --no-deps

# flash_attn compat shim for ARM64 (source build takes 18+ hours under QEMU)
# Creates a package that delegates to verl's flash_attn_compat for bert_padding/ops
# and provides stub CUDA functions that route to PyTorch SDPA
RUN SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    mkdir -p $SITE/flash_attn/ops/triton $SITE/flash_attn/layers $SITE/flash_attn-2.7.0.dist-info && \
    echo '__version__ = "2.7.0"' > $SITE/flash_attn/__init__.py && \
    echo 'from verl.utils.flash_attn_compat import pad_input, unpad_input, index_first_axis, rearrange' > $SITE/flash_attn/bert_padding.py && \
    echo 'from verl.utils.flash_attn_compat import flash_attn_func, flash_attn_varlen_func' >> $SITE/flash_attn/__init__.py && \
    echo '# ops' > $SITE/flash_attn/ops/__init__.py && \
    echo '# triton ops' > $SITE/flash_attn/ops/triton/__init__.py && \
    echo 'def apply_rotary(*a, **k): raise RuntimeError("Use SDPA on ARM64")' > $SITE/flash_attn/ops/triton/rotary.py && \
    echo 'from verl.utils.flash_attn_compat import cross_entropy_loss' > $SITE/flash_attn/ops/triton/cross_entropy.py && \
    echo 'class RMSNorm: pass' > $SITE/flash_attn/ops/triton/layer_norm.py && \
    echo 'def fused_dense_func(*a, **k): pass' > $SITE/flash_attn/ops/fused_dense.py && \
    echo '# layers' > $SITE/flash_attn/layers/__init__.py && \
    echo 'class RotaryEmbedding: pass' > $SITE/flash_attn/layers/rotary.py && \
    echo 'from verl.utils.flash_attn_compat import flash_attn_func, flash_attn_varlen_func' > $SITE/flash_attn/flash_attn_interface.py && \
    printf 'Metadata-Version: 2.1\nName: flash-attn\nVersion: 2.7.0\n' > $SITE/flash_attn-2.7.0.dist-info/METADATA && \
    echo 'flash_attn' > $SITE/flash_attn-2.7.0.dist-info/top_level.txt

# Install verl from our branch with MX checkpoint engine
WORKDIR /opt/verl
COPY . /opt/verl/
RUN pip install -e ".[gpu]" 2>/dev/null || pip install -e . 2>/dev/null || \
    pip install ray transformers datasets accelerate omegaconf hydra-core \
    tensordict pydantic pyzmq aiohttp httpx cupy-cuda12x

# Install MX client directly via pip (avoids copy path issues)
RUN pip install --no-deps \
    "modelexpress @ git+https://github.com/ai-dynamo/modelexpress.git@kavink/RL#subdirectory=modelexpress_client/python" && \
    pip install grpcio protobuf

# Install NIXL into the environment
RUN VSITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    cp -r /opt/nixl-install/lib/python3/dist-packages/nixl_cu12 $VSITE/nixl_cu12 2>/dev/null; \
    ln -sf $VSITE/nixl_cu12 $VSITE/nixl 2>/dev/null; \
    python3 -c "import modelexpress; print('MX:', modelexpress.__file__)" && \
    python3 -c "import nixl; print('NIXL:', nixl.__file__)" && \
    echo "modelexpress + nixl verified"

# Environment for RDMA
ENV UCX_TLS="self,sm,rc,cuda_copy,gdr_copy,tcp" \
    UCX_IB_GID_INDEX="3" \
    NIXL_LOG_LEVEL="INFO" \
    MODEL_EXPRESS_URL="modelexpress-server:8001" \
    OMPI_MCA_pml="ob1" \
    OMPI_MCA_btl="tcp,self,vader"

WORKDIR /opt/verl
